{
  "name": "greencode",
  "version": "0.1.0",
  "description": "API de gestao de logistica reversa de equipamentos eletronicos.",
  "main": "dist/http/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/http/main.js",
    "dev": "ts-node src/http/main.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:journey": "jest tests/jornada-api.tests.ts --runInBand",
    "lint": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "ts-node src/seed.ts"
  },
  "keywords": ["greencode", "logistica-reversa", "api", "fastify", "prisma", "typescript"],
  "author": "",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "jest": "^29.7.0",
    "jest-util": "^29.7.0",
    "prisma": "6.19.3",
    "ts-jest": "^29.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@fastify/jwt": "^9.1.0",
    "@prisma/client": "6.19.3",
    "dotenv": "^18.0.8",
    "fastify": "^5.12.7"
  }
}
